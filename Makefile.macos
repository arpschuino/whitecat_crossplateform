# ============================================================
# WhiteCat - Build macOS (Apple Clang, SDL2, CoreMIDI/RtMidi)
# Usage : make -f Makefile.macos -j8
#         make -f Makefile.macos clean
#
# Prerequis (Homebrew) :
#   xcode-select --install
#   brew install pkg-config sdl2 sdl2_ttf sdl2_image sdl2_mixer libharu rtmidi
#
# RtMidi : librairie Homebrew (backend CoreMIDI), pas les sources du kit Windows.
# OpenGL : framework systeme (legacy 2.1, glLineStipple dans plot9.cpp).
#          SDL_HINT_RENDER_DRIVER="opengl" est force dans graphics_backend.h
#          (le defaut Metal casserait les appels GL directs).
# DMX USB : Enttec Open / Pro via /dev/cu.usbserial-* (driver FTDI Apple integre).
# OpenCV (video tracking) : desactive par #ifdef _WIN32 (stubs).
# Pas de PCH : clang n'utilise pas wc_tus.h.gch sur un #include ordinaire.
# ============================================================

SRC     := $(CURDIR)/Src
OUT     := $(CURDIR)/whitecatbuild/build/macos

CXX     := clang++

PKGS        := sdl2 SDL2_ttf SDL2_image SDL2_mixer rtmidi
PKG_CFLAGS  := $(shell pkg-config --cflags $(PKGS) 2>/dev/null)
PKG_LIBS    := $(shell pkg-config --libs   $(PKGS) 2>/dev/null)
BREW_PREFIX := $(shell brew --prefix 2>/dev/null || echo /opt/homebrew)

CFLAGS  := -D__POSIX__ \
            -DGL_SILENCE_DEPRECATION \
            -std=c++11 -O2 -g -w \
            $(PKG_CFLAGS)

INCS    := -I$(SRC) \
            -I$(BREW_PREFIX)/include

LDFLAGS := $(PKG_LIBS) \
            -L$(BREW_PREFIX)/lib -lhpdf -lz -lpthread \
            -framework OpenGL \
            -framework CoreMIDI -framework CoreAudio -framework CoreFoundation \
            -framework IOKit \
            -Wl,-rpath,@executable_path/lib

# ============================================================
# Sources (identiques a Makefile.linux)
# ============================================================

