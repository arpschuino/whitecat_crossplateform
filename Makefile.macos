# ============================================================
# Objets et dependances
# ============================================================

OBJS := $(SRC_CPPS:$(SRC)/%.cpp=$(OUT)/%.o)
DEPS := $(OBJS:.o=.d)

EXE  := $(OUT)/Whitecat_Crossplatform

# ============================================================
# Cibles
# ============================================================

.PHONY: all clean dirs package

all: dirs $(EXE)
	@echo
	@echo [OK] $(EXE)

# ============================================================
# Paquet autonome (non signe) : exe + dylibs Homebrew dans lib/ + fichiers
# d'execution. Tourne sur un Mac sans Homebrew (meme architecture).
# Prerequis : brew install dylibbundler ; ./setup_macos.sh (fichiers d'exec)
# sdl2-compat charge SDL3 par dlopen (invisible pour dylibbundler) : on le
# copie a cote (il cherche d'abord @loader_path/libSDL3.dylib).
# ============================================================
ARCH         := $(shell uname -m)
DIST_NAME    := Whitecat_Crossplatform_macos_$(ARCH)
DIST         := $(CURDIR)/whitecatbuild/dist/$(DIST_NAME)
RUNTIME_DIRS := Fonts audio gfx import_export plans ressources saves user

package: all
	rm -rf $(DIST) $(DIST).tar.gz
	mkdir -p $(DIST)/lib
	cp $(EXE) $(DIST)/
	for d in $(RUNTIME_DIRS); do \
	    if [ -d $(OUT)/$$d ]; then cp -R $(OUT)/$$d $(DIST)/; \
	    else echo "[package] $$d/ absent : lancez ./setup_macos.sh"; exit 1; fi; \
	done
	dylibbundler -of -b -x $(DIST)/Whitecat_Crossplatform -d $(DIST)/lib -p @executable_path/lib/
	cp -L $(shell brew --prefix sdl3)/lib/libSDL3.dylib $(DIST)/lib/libSDL3.dylib
	chmod u+w $(DIST)/lib/*.dylib
	install_name_tool -id @executable_path/lib/libSDL3.dylib $(DIST)/lib/libSDL3.dylib
	codesign --force -s - $(DIST)/lib/*.dylib
	codesign --force -s - $(DIST)/Whitecat_Crossplatform
	tar -C $(dir $(DIST)) -czf $(DIST).tar.gz $(DIST_NAME)
	@echo
	@echo [OK] $(DIST).tar.gz

$(EXE): $(OBJS)
	@echo [link] Whitecat_Crossplatform ...
	$(CXX) $^ $(LDFLAGS) -o $@

$(OUT)/%.o: $(SRC)/%.cpp
	@echo [cc] $(<F)
	$(CXX) $(CFLAGS) $(INCS) -MMD -MP -c $< -o $@

dirs:
	mkdir -p $(OUT)

clean:
	rm -f $(OUT)/*.o $(OUT)/*.d $(EXE)
	@echo [clean] OK

-include $(DEPS)
