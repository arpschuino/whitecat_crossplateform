{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run WhiteCat",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/whitecatbuild/build/white_cat_for_mingw/Whitecat_Crossplatform.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/whitecatbuild/build/white_cat_for_mingw",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "Debug WhiteCat (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/whitecatbuild/build/white_cat_for_mingw/Whitecat_Crossplatform.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/whitecatbuild/build/white_cat_for_mingw",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/tools/MinGW/bin/gdb32.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
